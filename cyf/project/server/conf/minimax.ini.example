# 将此段合并到实际加载的后端配置；开发环境为 conf/conf.dev.ini。
# 也可设置环境变量 MINIMAX_API_KEY；密钥仅由后端读取。
[minimax]
api_key=<填入你的 MiniMax API Key>
region=cn
key_kind=token_plan
model=speech-2.8-hd
timeout_seconds=180
# MP3、正文导出和文件锁；台账与链接使用现有平台 SQLite。
storage_dir=voice_data

[minimax_music]
# 音乐生成与音色复刻使用的计费凭据；留空则沿用上面的 [minimax]。
# Token Plan 密钥只能合成语音、不能创建音色，复刻需要这里的计费密钥。
# 环境变量 MINIMAX_MUSIC_API_KEY 优先于本段。
api_key=
region=
key_kind=token_plan
# 文本生音乐模型，可选 music-3.0、music-2.6。
model=music-3.0
timeout_seconds=
